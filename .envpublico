# Parámetros Generales del Bot de Trading Binance (Público)
SYMBOL=BTCUSDT
MARGIN_USDT=5.0
LEVERAGE=10

# Estrategia a Ejecutar (1 = Divergencia RSI+Oracle+VWAP, 2 = Apertura Market Open, ALL = Ambas)
ACTIVE_STRATEGY=ALL

# Porcentajes de Take Profit y Stop Loss sobre el capital invertido (ROI 3%)
TP_ROI_PCT=3.0
SL_ROI_PCT=3.0

# Configuración Estrategia 1 (1 min: Divergencia RSI + Oracle + VWAP)
TIMEFRAME_STRAT1=1m
RSI_PERIOD=14
PIVOT_LOOKBACK_LEFT=5
PIVOT_LOOKBACK_RIGHT=2
STRAT1_SCHEDULE_START=10:30
STRAT1_SCHEDULE_END=17:00

# Configuración Estrategia 2 (Apertura 10:30 hs Buenos Aires, Velas 1m y 5m)
OPENING_TIME=10:30
TIMEFRAME_STRAT2_OPEN=1m
TIMEFRAME_STRAT2_TREND=5m
STRAT2_SCHEDULE_START=10:00
STRAT2_SCHEDULE_END=18:00

# Modos de Ejecución
DRY_RUN=False
USE_TESTNET=False

# Configuración de Horario de Operaciones General
ENABLE_SCHEDULE_FILTER=True
SCHEDULE_WEEKDAYS_ONLY=True
