# Parámetros Generales del Bot de Trading Binance Futures (Público)
SYMBOL=BTCUSDT
# Monto en USDT por operación
MARGIN_USDT=5.0
LEVERAGE=10
MARGIN_TYPE=ISOLATED

# Estrategia: Vela apertura
STRATEGY_NAME=Vela apertura
TIMEFRAME=1m

# Take Profit: 10% de ganancia en ROE (sin Stop Loss)
TAKE_PROFIT_PCT=10.0

# Horarios de Apertura de Bolsas (Horario Buenos Aires UTC-3)
# Formato: HORA:MINUTO:BOLSAS
# Euronext: 04:00 | New York: 10:30 | Tokio: 21:00
SESSIONS_CONFIG=EURONEXT:04:00,NEW YORK:10:30,TOKIO:21:00

# Modos de Ejecución (Operación con Dinero Real)
DRY_RUN=False
USE_TESTNET=False

# Intervalo de actualización en segundos para monitoreo continuo
POLL_INTERVAL_SEC=1
