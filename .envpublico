# Parámetros Generales del Bot de Trading Binance Futures (Público)
SYMBOL=BTCUSDT
MARGIN_USDT=5.0
LEVERAGE=10
MARGIN_TYPE=ISOLATED

# Estrategia: VWAP (Velas de 1 hora, Operación 24/7)
TIMEFRAME=1h

# Operación 24 hs los 7 días de la semana
OPERATE_24_7=True

# Modos de Ejecución (Operación con Dinero Real)
DRY_RUN=False
USE_TESTNET=False

# Intervalo de actualización en segundos
POLL_INTERVAL_SEC=3
